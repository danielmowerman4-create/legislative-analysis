# Copy to .env.local and fill in. Never commit real values.
APP_ENV=development            # development | test | demo | production
APP_URL=http://localhost:3000  # https:// required in production
DATABASE_URL=pglite://.data/pglite   # postgres://user:pass@host:5432/db in production
SESSION_SECRET=                # >= 32 random characters (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=          # 32 random bytes, base64 (openssl rand -base64 32); encrypts MFA secrets and mailbox credentials
TOKEN_ENCRYPTION_KEY_ID=k1
TOKEN_ENCRYPTION_OLD_KEYS=     # optional, for rotating the key: id:base64key,id:base64key
WORKER_MODE=inline             # inline (dev) | external (run `npm run worker`) | off
CT_SOURCE=live                 # live (read the state on a schedule) | snapshot (local copy, for development)
REDIS_URL=                     # optional: enables the BullMQ transport
CONTACT_EMAIL=                 # optional: shown under Questions on the public privacy page
NEXT_PUBLIC_DISPLAY_TIMEZONE=America/New_York   # zone used to display dates and times

# Production (optional)
MIGRATION_DATABASE_URL=        # login that owns the tables; the image migrates with it, then serves with DATABASE_URL
DB_POOL_MAX=10
WORKER_CONCURRENCY=4

# Legislative data
LEGISCAN_API_KEY=
OPENSTATES_API_KEY=

# Constituent Center (leave blank until an office is ready to connect a mailbox)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GEOCODIO_API_KEY=              # district lookup from addresses; leave blank to go without
ANTHROPIC_API_KEY=             # blank means mail is read by rules only
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_CLASSIFY_EFFORT=low
ANTHROPIC_EFFORT=medium
