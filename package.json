{
  "name": "legislative-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Bill tracking and constituent mail for state legislative offices.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "office:create": "tsx --env-file-if-exists=.env.local scripts/create-office.ts",
    "center:enable": "tsx --env-file-if-exists=.env.local scripts/constituent-center.ts",
    "center:import-rules": "tsx --env-file-if-exists=.env.local scripts/import-sender-rules.ts",
    "private": "node scripts/private.mjs",
    "microsoft:register": "node scripts/register-microsoft.mjs",
    "legislation:check": "tsx --env-file-if-exists=.env.local scripts/legislation-sync.ts --check",
    "legislation:sync": "tsx --env-file-if-exists=.env.local scripts/legislation-sync.ts",
    "demo:seed": "tsx --env-file=.env.demo scripts/seed-demo.ts",
    "demo": "node scripts/with-env.mjs .env.demo next dev --port 3100",
    "openapi": "tsx scripts/openapi.ts",
    "schema:doc": "tsx --env-file-if-exists=.env.local scripts/schema-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "bullmq": "^6.7.1",
    "chrono-node": "^2.10.3",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "franc-min": "^6.2.0",
    "imapflow": "1.7.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "postal-mime": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "3.5.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "smtp-server": "3.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
